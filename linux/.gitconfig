[user]
	name = Bouchet07
	email = diegobouchet88@gmail.com

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true
	line-numbers = true
	syntax-theme = Monokai Extended
	file-style = bold cyan
	file-decoration-style = ul "#444444"
	hunk-header-decoration-style = "#444444" box
	line-numbers-left-style = "#666666"
	line-numbers-right-style = "#666666"
	line-numbers-plus-style = green
	line-numbers-minus-style = red

[merge]
	conflictStyle = zdiff3

[diff]
	colorMoved = default
